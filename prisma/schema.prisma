datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum UserRole {
  USER
  ADMIN
}

enum NodeType {
  CONCEPT        // Key concept node generated by AI or user
  TEXT_NOTE      // Rich text note card
  WEB_CLIP       // Captured web clip node
  DOCUMENT       // PDF/Doc summary root node
  REMINDER_NODE  // Node with active scheduled deadline
}

enum NotePriority {
  LOW
  MEDIUM
  HIGH
}

enum EdgeType {
  DEFAULT
  SMOOTHSTEP
  STRAIGHT
  BEZIER
}

enum NotificationStatus {
  PENDING
  DISPATCHED
  DISMISSED
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  emailVerified Boolean        @default(false)
  name          String?
  image         String?
  role          UserRole       @default(USER)
  passwordHash  String?
  username      String?        @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  sessions       Session[]
  accounts       Account[]
  notes          Note[]
  canvases       Canvas[]
  notifications  Notification[]
  webhooks       Webhook[]
  discordAccount DiscordAccount?
  smtpConfig     SmtpConfig?
  captures       Capture[]
  tasks          Task[]
  telegramAccount TelegramAccount?
  calendarEvents CalendarEvent[]
  sentFriendRequests     FriendRequest[]      @relation("SentRequests")
  receivedFriendRequests FriendRequest[]      @relation("ReceivedRequests")
  conversationMembers    ConversationMember[]
  chatMessages           ChatMessage[]
  canvasCollaborators    CanvasCollaborator[]

  @@map("users")
}

// Better-Auth Standard Session Model
model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// Better-Auth Standard Account Model
model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?   @db.Text
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

// Better-Auth Verification Tokens
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// Classic Note Model
model Note {
  id          String       @id @default(cuid())
  userId      String
  canvasId    String?      // Optional link to visual mind map
  title       String       @default("Untitled Note")
  content     String       @db.Text
  tags        String[]     @default([])
  priority    NotePriority @default(MEDIUM)
  isPinned    Boolean      @default(false)
  isArchived  Boolean      @default(false)
  reminderAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  canvas      Canvas?      @relation(fields: [canvasId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([userId])
  @@index([reminderAt])
  @@map("notes")
}

model Canvas {
  id            String         @id @default(cuid())
  userId        String
  title         String         @default("Untitled MindSpace")
  description   String?        @db.Text
  isPublic      Boolean        @default(false)
  
  viewportX     Float          @default(0)
  viewportY     Float          @default(0)
  zoom          Float          @default(1)
  layoutEngine  String         @default("layered")

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes         Note[]
  nodes         Node[]
  edges         Edge[]
  collaborators CanvasCollaborator[]

  @@index([userId])
  @@map("canvases")
}

model Node {
  id            String         @id @default(cuid())
  canvasId      String
  parentId      String?

  type          NodeType       @default(CONCEPT)
  label         String
  content       Json?
  markdown      String?        @db.Text
  
  positionX     Float          @default(0)
  positionY     Float          @default(0)
  width         Float?         @default(260)
  height        Float?         @default(120)
  color         String?        @default("#FF3D00")
  icon          String?
  isCollapsed   Boolean        @default(false)

  reminderAt    DateTime?
  embedding     Unsupported("vector(1536)")?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  canvas        Canvas         @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  parent        Node?          @relation("NodeHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      Node[]         @relation("NodeHierarchy")
  
  outgoingEdges Edge[]         @relation("SourceEdges")
  incomingEdges Edge[]         @relation("TargetEdges")
  notifications Notification[]

  @@index([canvasId])
  @@index([reminderAt])
  @@map("nodes")
}

model Edge {
  id            String         @id @default(cuid())
  canvasId      String
  sourceId      String
  targetId      String

  label         String?
  relation      String?        @default("ASSOCIATED_WITH")
  edgeType      EdgeType       @default(SMOOTHSTEP)
  animated      Boolean        @default(false)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  canvas        Canvas         @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  source        Node           @relation("SourceEdges", fields: [sourceId], references: [id], onDelete: Cascade)
  target        Node           @relation("TargetEdges", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([canvasId, sourceId, targetId])
  @@index([canvasId])
  @@map("edges")
}

model Notification {
  id            String             @id @default(cuid())
  userId        String
  nodeId        String?
  noteId        String?
  taskId        String?
  title         String
  message       String
  status        NotificationStatus @default(PENDING)
  scheduledFor  DateTime
  dispatchedAt  DateTime?
  channels      String[]           @default(["in_app"])
  metadata      Json?
  retryCount    Int                @default(0)
  lastError     String?

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  node          Node?              @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  note          Note?              @relation(fields: [noteId], references: [id], onDelete: Cascade)
  task          Task?              @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("notifications")
}

model TelegramAccount {
  id             String   @id @default(cuid())
  userId         String   @unique
  telegramChatId String
  username       String?
  isPaired       Boolean  @default(false)
  pairingCode    String?  @unique
  botToken       String?  // user-owned token (overrides global)
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("telegram_accounts")
}

model Webhook {
  id            String         @id @default(cuid())
  userId        String
  name          String
  targetUrl     String
  secret        String
  events        String[]
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("webhooks")
}

model DiscordAccount {
  id              String   @id @default(cuid())
  userId          String   @unique
  pairingCode     String?  @unique
  discordUserId   String?  @unique
  discordUsername String?
  webhookUrl      String?
  botToken        String?
  isPaired        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("discord_accounts")
}

model SmtpConfig {
  id        String   @id @default(cuid())
  userId    String   @unique
  host      String   @default("smtp.gmail.com")
  port      Int      @default(587)
  username  String
  password  String
  fromEmail String
  isGmail   Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("smtp_configs")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model Capture {
  id        String   @id @default(cuid())
  userId    String
  rawText   String   @db.Text
  sourceUrl String?
  status    String   @default("PENDING") // PENDING | PROCESSED | DISCARDED
  canvasId  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("captures")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

model Task {
  id          String       @id @default(cuid())
  userId      String
  parentId    String?      // null = Macro Task, set = Micro Task
  title       String
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueAt       DateTime?
  isPinned    Boolean      @default(false)
  tags        String[]     @default([])
  notifyEvery Int?         // minutes between nudges (Sprint 3)
  channels    String[]     @default(["in_app"]) // Sprint 3
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Task?  @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subtasks Task[] @relation("TaskHierarchy")
  notifications Notification[]

  @@index([userId, status])
  @@index([dueAt])
  @@map("tasks")
}

enum EventRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model CalendarEvent {
  id          String          @id @default(cuid())
  userId      String
  title       String
  description String?         @db.Text
  startAt     DateTime
  endAt       DateTime?
  isAllDay    Boolean         @default(false)
  location    String?
  color       String          @default("#4285F4")
  recurrence  EventRecurrence @default(NONE)
  sourceType  String          @default("EVENT")
  sourceId    String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startAt])
  @@map("calendar_events")
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

model FriendRequest {
  id         String              @id @default(cuid())
  senderId   String
  receiverId String
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())

  sender   User @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@map("friend_requests")
}

model Conversation {
  id           String               @id @default(cuid())
  name         String?
  isGroup      Boolean              @default(false)
  iconUrl      String?
  inviteToken  String?              @unique
  inviteExpiry DateTime?
  createdAt    DateTime             @default(now())

  members  ConversationMember[]
  messages ChatMessage[]

  @@map("conversations")
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  role           String       @default("MEMBER")
  joinedAt       DateTime     @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_members")
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String       @db.Text
  type           String       @default("TEXT")
  readBy         String[]     @default([])
  editedAt       DateTime?
  createdAt      DateTime     @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

model CanvasCollaborator {
  id        String   @id @default(cuid())
  canvasId  String
  userId    String
  role      String   @default("VIEWER")
  invitedAt DateTime @default(now())

  canvas Canvas @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([canvasId, userId])
  @@map("canvas_collaborators")
}
