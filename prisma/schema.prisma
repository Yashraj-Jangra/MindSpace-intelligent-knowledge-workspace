datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum UserRole {
  USER
  ADMIN
}

enum NodeType {
  CONCEPT        // Key concept node generated by AI or user
  TEXT_NOTE      // Rich text note card
  WEB_CLIP       // Captured web clip node
  DOCUMENT       // PDF/Doc summary root node
  REMINDER_NODE  // Node with active scheduled deadline
}

enum EdgeType {
  DEFAULT
  SMOOTHSTEP
  STRAIGHT
  BEZIER
}

enum NotificationStatus {
  PENDING
  DISPATCHED
  DISMISSED
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  emailVerified Boolean        @default(false)
  name          String?
  image         String?
  role          UserRole       @default(USER)
  passwordHash  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  sessions       Session[]
  accounts       Account[]
  canvases       Canvas[]
  notifications  Notification[]
  webhooks       Webhook[]
  discordAccount DiscordAccount?
  smtpConfig     SmtpConfig?

  @@map("users")
}

// Better-Auth Standard Session Model
model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// Better-Auth Standard Account Model for OAuth (Google) and Credentials
model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?   @db.Text
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

// Better-Auth Verification Tokens
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

model Canvas {
  id            String         @id @default(cuid())
  userId        String
  title         String         @default("Untitled MindSpace")
  description   String?        @db.Text
  isPublic      Boolean        @default(false)
  
  viewportX     Float          @default(0)
  viewportY     Float          @default(0)
  zoom          Float          @default(1)
  layoutEngine  String         @default("layered")

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodes         Node[]
  edges         Edge[]

  @@index([userId])
  @@map("canvases")
}

model Node {
  id            String         @id @default(cuid())
  canvasId      String
  parentId      String?

  type          NodeType       @default(CONCEPT)
  label         String
  content       Json?
  markdown      String?        @db.Text
  
  // React Flow Visual Properties
  positionX     Float          @default(0)
  positionY     Float          @default(0)
  width         Float?         @default(260)
  height        Float?         @default(120)
  color         String?        @default("#FF3D00")
  icon          String?
  isCollapsed   Boolean        @default(false)

  // Reminders & Deadlines
  reminderAt    DateTime?

  // Vector Embedding for local search (1536 dims)
  embedding     Unsupported("vector(1536)")?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  canvas        Canvas         @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  parent        Node?          @relation("NodeHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      Node[]         @relation("NodeHierarchy")
  
  outgoingEdges Edge[]         @relation("SourceEdges")
  incomingEdges Edge[]         @relation("TargetEdges")
  notifications Notification[]

  @@index([canvasId])
  @@index([reminderAt])
  @@map("nodes")
}

model Edge {
  id            String         @id @default(cuid())
  canvasId      String
  sourceId      String
  targetId      String

  label         String?
  relation      String?        @default("ASSOCIATED_WITH")
  edgeType      EdgeType       @default(SMOOTHSTEP)
  animated      Boolean        @default(false)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  canvas        Canvas         @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  source        Node           @relation("SourceEdges", fields: [sourceId], references: [id], onDelete: Cascade)
  target        Node           @relation("TargetEdges", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([canvasId, sourceId, targetId])
  @@index([canvasId])
  @@map("edges")
}

model Notification {
  id            String             @id @default(cuid())
  userId        String
  nodeId        String?
  title         String
  message       String
  status        NotificationStatus @default(PENDING)
  scheduledFor  DateTime
  dispatchedAt  DateTime?

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  node          Node?              @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("notifications")
}

model Webhook {
  id            String         @id @default(cuid())
  userId        String
  name          String
  targetUrl     String
  secret        String
  events        String[]
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("webhooks")
}

// Discord Account Integration & Account Linking
model DiscordAccount {
  id              String   @id @default(cuid())
  userId          String   @unique
  pairingCode     String?  @unique
  discordUserId   String?  @unique
  discordUsername String?
  webhookUrl      String?
  botToken        String?
  isPaired        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("discord_accounts")
}

// SMTP Email Sender Configuration
model SmtpConfig {
  id        String   @id @default(cuid())
  userId    String   @unique
  host      String   @default("smtp.gmail.com")
  port      Int      @default(587)
  username  String
  password  String   // Encrypted SMTP/App Password
  fromEmail String
  isGmail   Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("smtp_configs")
}

// Admin System Configuration KV Store
model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}
