# Database Configuration (Dockerized PostgreSQL + pgvector)
DATABASE_URL="postgresql://mindspace_user:mindspace_password@localhost:5432/mindspace_db?schema=public"

# AI Provider Configuration
OPENAI_API_KEY="your-openai-api-key-here"

# MinIO Object Storage (Local S3 compatible)
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadminpassword"
MINIO_BUCKET_NAME="mindspace-assets"

# Webhooks Defaults
WEBHOOK_SECRET_KEY="mindspace_local_webhook_secret"
